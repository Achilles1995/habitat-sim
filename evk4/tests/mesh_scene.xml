<mujoco model="evk4 mesh / texture / distortion test">
  <compiler meshdir="assets" texturedir="assets"/>
  <option timestep="0.001" gravity="0 0 0"/>
  <extension><plugin plugin="prophesee.sensor.evk4"/></extension>
  <visual><global bvactive="false" offwidth="640" offheight="360"/><headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/></visual>
  <asset>
    <mesh name="uvsphere" file="uvsphere.obj"/>
    <mesh name="quad" file="quad.obj"/>
    <texture name="orient" type="2d" file="orient.png"/>
    <material name="orient" texture="orient"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.1 0.1 0.1" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true"/>
  </asset>
  <worldbody>
    <light name="key" type="directional" dir="-0.3 0.2 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" ambient="0.15 0.15 0.15" castshadow="true"/>
    <geom name="floor" type="plane" size="1 1 0.1" material="grid"/>
    <body name="quadb" pos="-0.12 0 0.0"><joint name="qspin" type="hinge" axis="0 0 1" damping="0"/><geom name="quad" type="mesh" mesh="quad" material="orient" contype="0" conaffinity="0"/></body>
    <body name="ball" pos="0.12 0 0.07"><joint name="spin" type="hinge" axis="0 0 1"/><geom name="ball" type="mesh" mesh="uvsphere" rgba="0.8 0.8 0.8 1"/></body>
    <body name="cam" pos="0 0 0.45"><camera name="c" fovy="50"/></body>
  </worldbody>
  <sensor>
    <plugin name="evk4" plugin="prophesee.sensor.evk4" objtype="camera" objname="c">
      <config key="resolution" value="640 360"/>
      <config key="focal_length_mm" value="2.9"/>
      <config key="psf_sigma_px" value="0"/>
      <config key="lux_per_unit" value="1000"/>
    </plugin>
  </sensor>
</mujoco>
